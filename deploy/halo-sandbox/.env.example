# Copy to .env (scripts/setup.sh does this and fills in the IDs and API key).
# .env is git-ignored. Never commit it.

# Host account that owns this directory and the workspace (id -u / id -g).
HALO_UID=1000
HALO_GID=1000

# Numeric GIDs of the host's "render" and "video" groups, and the GPU render node.
HALO_RENDER_GID=
HALO_VIDEO_GID=
HALO_RENDER_NODE=/dev/dri/renderD128

# Model files live on the host and are mounted read-only.
HALO_MODELS_DIR=/srv/models
# For split GGUF files, name the first part (...-00001-of-0000N.gguf).
LLM_MODEL_FILE=
LLM_ALIAS=local-model
LLM_CTX_SIZE=65536
# Shared secret between the agent and llama-server (setup.sh generates it).
LLM_API_KEY=

# The project directory the agent may read and write. Keep secrets out of it.
HALO_WORKSPACE=./workspace
AGENT_MEM_LIMIT=16g

# Resolvers used by the gateway and cloudflared. The host firewall
# (host/halo-firewall.nft) allows DNS to these two addresses only.
HALO_DNS_PRIMARY=1.1.1.1
HALO_DNS_SECONDARY=1.0.0.1

# Optional: Cloudflare Tunnel token (profile "tunnel").
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Cloudflare Access service token the gateway adds for the hosts in
# cf-access-domains.txt. Stays in the gateway; the sandbox never sees it.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: if your network inspects TLS (e.g. Cloudflare Gateway with TLS
# decryption), paste its root CA into ./build-ca.pem before building. It is used
# only during the image build and never stored in the image. Compose reads build
# secrets only from inside this directory.
# HALO_BUILD_CA=./build-ca.pem
